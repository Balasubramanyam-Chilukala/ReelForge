{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReelForge",
  "version": "0.1.0",
  "identifier": "ai.reelforge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ReelForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packages/backend/dist/reelforge-backend.bundle.cjs": "backend/reelforge-backend.cjs",
      "../../../packages/mcp/dist/reelforge-mcp.bundle.cjs": "mcp/reelforge-mcp.cjs"
    },
    "longDescription": "AI-first desktop video editor for Reels, Shorts and TikToks, controllable by Claude Code and OpenCode.",
    "shortDescription": "AI-first reel editor"
  }
}
