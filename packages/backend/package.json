{
  "name": "@reelforge/backend",
  "version": "0.1.0",
  "description": "ReelForge backend daemon: authoritative project state, SQLite persistence, job queue, and the local HTTP+WS bridge.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "reelforge-backend": "./dist/bin/reelforge-backend.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/bin/reelforge-backend.ts --bundle --platform=node --format=cjs --target=node22 --external:node:sqlite --outfile=dist/reelforge-backend.bundle.cjs",
    "test": "vitest run",
    "start": "node --no-warnings dist/bin/reelforge-backend.js"
  },
  "dependencies": {
    "@reelforge/engine": "workspace:*",
    "@reelforge/media": "workspace:*",
    "@reelforge/shared": "workspace:*",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/ws": "8.5.13"
  },
  "license": "MIT"
}
