{
  "name": "@reelforge/mcp",
  "version": "0.1.0",
  "description": "reelforge-mcp: stdio MCP server exposing the ReelForge editor to Claude Code and OpenCode. Thin adapter over the backend bridge; no editing logic.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "reelforge-mcp": "./dist/bin/reelforge-mcp.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/bin/reelforge-mcp.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/reelforge-mcp.bundle.cjs",
    "test": "vitest run",
    "start": "node --no-warnings dist/bin/reelforge-mcp.js"
  },
  "dependencies": {
    "@reelforge/engine": "workspace:*",
    "@reelforge/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.12.1",
    "zod": "3.23.8"
  },
  "license": "MIT"
}
