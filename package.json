{
  "name": "reelforge",
  "version": "0.1.0",
  "private": true,
  "description": "ReelForge — AI-first cross-platform desktop video editor with Claude Code & OpenCode MCP control.",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "bundle": "pnpm --filter @reelforge/backend bundle && pnpm --filter @reelforge/mcp bundle",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "backend": "pnpm --filter @reelforge/backend start",
    "mcp": "pnpm --filter @reelforge/mcp start",
    "clean": "pnpm -r exec rimraf dist"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "2.1.8",
    "esbuild": "0.21.5",
    "@types/node": "22.10.5"
  }
}
